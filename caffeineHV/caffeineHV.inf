;
; caffeineHV.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = caffeineHV.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
caffeineHV.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%caffeineHV.DeviceDesc% = caffeineHV_Device, Root\caffeineHV ; TODO: edit hw-id

[caffeineHV_Device.NT]
CopyFiles = File_Copy

[File_Copy]
caffeineHV.sys

;-------------- Service installation
[caffeineHV_Device.NT.Services]
AddService = caffeineHV,%SPSVCINST_ASSOCSERVICE%, caffeineHV_Service_Inst

; -------------- caffeineHV driver install sections
[caffeineHV_Service_Inst]
DisplayName    = %caffeineHV.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\caffeineHV.sys

[caffeineHV_Device.NT.Wdf]
KmdfService = caffeineHV, caffeineHV_wdfsect

[caffeineHV_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "caffeineHV Installation Disk"
caffeineHV.DeviceDesc = "caffeineHV Device"
caffeineHV.SVCDESC = "caffeineHV Service"
